{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fe",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "fe-test-api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_API_BASE_URL=http://localhost:5055/api&& npx vite --port 5176 --strictPort"
