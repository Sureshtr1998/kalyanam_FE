# Copy to .env for local development. On Vercel, set these under
# Project Settings -> Environment Variables. Values in .env.production are
# committed defaults for production builds; Vercel variables override them.

# Required. Backend base URL, no trailing slash.
VITE_API_BASE_URL=http://localhost:5000

# Required. Razorpay key id (public). Use an rzp_test_ key outside production.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Required in production. Canonical site origin for SEO tags, sitemap and checkout logo.
# Falls back to the current origin in development.
VITE_SITE_URL=https://www.seetharamakalyana.in

# Optional. Meta (Facebook) Pixel id. Leave empty to disable tracking (recommended locally).
VITE_META_PIXEL_ID=
